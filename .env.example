# Supabase — возьми реальные значения в Dashboard → Project Settings → API Keys.
# НИКОГДА не коммить сюда настоящие ключи.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<publishable-key>
SUPABASE_SERVICE_ROLE_KEY=<secret-key>
SUPABASE_PROJECT_REF=<project-ref>

# SMS
SMSRU_API_KEY=

# CI/CD (для GitHub Actions — хранятся как secrets репозитория)
SUPABASE_ACCESS_TOKEN=
STAGING_PROJECT_REF=
PROD_PROJECT_REF=

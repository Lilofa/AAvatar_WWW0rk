{
  "name": "avatar-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend for Avatar app on Supabase",
  "scripts": {
    "start": "supabase start",
    "stop": "supabase stop",
    "reset": "supabase db reset",
    "lint": "supabase db lint",
    "test": "supabase test db",
    "gen-types": "supabase gen types typescript --local > types/database.ts",
    "deploy:functions": "supabase functions deploy",
    "push:staging": "supabase db push --linked",
    "diff": "supabase db diff"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "supabase": "^1.200.0",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "dotenv": "^17.4.2",
    "google-auth-library": "^11.0.2",
    "google-spreadsheet": "^5.3.0"
  }
}

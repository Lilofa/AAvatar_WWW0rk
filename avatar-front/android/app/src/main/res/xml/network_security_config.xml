<?xml version="1.0" encoding="utf-8"?>
<!-- Только HTTPS; пользовательские CA-сертификаты НЕ доверяются (защита от MITM
     через установленный на устройство корневой сертификат). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
